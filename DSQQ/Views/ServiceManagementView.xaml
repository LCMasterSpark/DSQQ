<UserControl x:Class="DSQQ.Views.ServiceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="1000">
    <!--
        服务管理页（P2）
        ─────────────────────────────────────────────────────────────
        设计要点：
        · 一键启动是"顺序编排 + 逐步反馈"，因此进度区不是装饰而是必需品：
          用户必须能看到卡在哪一步（例如"等待 SnowLuma 超时"）；
        · 停止按钮分成"只停桥接 / 只停 SnowLuma / 全停"，因为排查时经常只想重启其中一个；
        · 页面上明确写出**停止的安全性依据**（端口反查 PID），避免后来者改成按进程名杀。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 操作区 ══ -->
        <Border Grid.Row="0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <StackPanel>
                <TextBlock Text="一键启动 / 停止" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="按顺序启动 SnowLuma 与 qq-bridge，并等待端口就绪。协议同意与扫码登录需要在 SnowLuma 界面里自行完成。"
                           Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="StartAllButton" Content="一键启动" Width="120" Height="32"
                            Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Click="OnStartAllClick" />
                    <Button x:Name="StopBridgeButton" Content="停止桥接" Width="110" Height="32" Margin="8,0,0,0"
                            Click="OnStopBridgeClick" />
                    <Button x:Name="StopSnowLumaButton" Content="停止 SnowLuma" Width="130" Height="32" Margin="8,0,0,0"
                            Click="OnStopSnowLumaClick" />
                    <Button x:Name="StopAllButton" Content="全部停止" Width="110" Height="32" Margin="8,0,0,0"
                            Click="OnStopAllClick" />
                    <ProgressBar x:Name="BusyBar" Width="140" Height="6" Margin="16,0,0,0"
                                 IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="ProgressText" Text="就绪。"
                           Margin="0,12,0,0" TextWrapping="Wrap"
                           FontFamily="Consolas, Microsoft YaHei UI" />
            </StackPanel>
        </Border>

        <!-- ══ 当前监听端口 ══ -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                Background="{DynamicResource DsqqSurface}">
            <StackPanel>
                <TextBlock Text="端口与进程" FontWeight="SemiBold" FontSize="14" />
                <DataGrid x:Name="PortGrid" Margin="0,8,0,0" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="150" />
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80" />
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90" />
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button x:Name="RefreshPortsButton" Content="刷新端口状态" Width="130" Height="28"
                        Margin="0,8,0,0" HorizontalAlignment="Left"
                        Click="OnRefreshPortsClick" />
            </StackPanel>
        </Border>

        <!-- ══ 安全说明 ══ -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                Background="#FFF8E6" BorderBrush="#F0D9A0" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" Foreground="#6B5A20"
                       Text="停止服务时不会按进程名批量结束进程：SnowLuma 与 qq-bridge 都使用 node.exe（SnowLuma 自带运行时），按名字杀会互相误杀。本程序一律从端口反查出 PID，只终止那一棵进程树，并在停止桥接后清理 state/bridge.lock。" />
        </Border>

        <!-- ══ 最近一次操作记录 ══ -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                Background="{DynamicResource DsqqSurface}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="操作记录" FontWeight="SemiBold" FontSize="14" />
                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Text="（暂无）"
                               FontFamily="Consolas, Microsoft YaHei UI"
                               TextWrapping="Wrap" LineHeight="19" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="HintText" Margin="2,10,0,0" Opacity="0.55"
                   TextTrimming="CharacterEllipsis" Text="—" />
    </Grid>
</UserControl>
