<UserControl x:Class="DSQQ.Views.SnowLumaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <!--
        SnowLuma 页。
        登录态、QQ 进程注入状态、OneBot 连接配置。
        合规提示：协议同意与扫码登录必须在 SnowLuma 自己的界面完成，本页只做只读展示与状态提示。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 登录区 -->
        <Border Grid.Row="0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <StackPanel>
                <TextBlock Text="WebUI 登录" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                           Text="密码以 Windows DPAPI 加密后保存在本机配置中，只能由当前用户解密。登录状态（Cookie）同样会被保存，用于免重复登录。" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="密码" VerticalAlignment="Center" />
                    <PasswordBox x:Name="PasswordBox" Width="220" Margin="8,0,0,0" />

                    <TextBlock Text="验证码" Margin="12,0,0,0" VerticalAlignment="Center"
                               ToolTip="仅当账号启用两步验证时填写" />
                    <TextBox x:Name="TotpBox" Width="90" Margin="8,0,0,0" />

                    <Button x:Name="LoginButton" Content="登录" Width="90" Height="30" Margin="12,0,0,0"
                            Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnLoginClick" />
                    <Button x:Name="LogoutButton" Content="退出登录" Width="100" Height="30" Margin="8,0,0,0"
                            Click="OnLogoutClick" />
                </StackPanel>

                <TextBlock x:Name="LoginStatusText" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
        </Border>

        <!-- 概览 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                Background="{DynamicResource DsqqSurface}">
            <StackPanel>
                <TextBlock Text="概览" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="OverviewText" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19" Text="尚未采集。" />
                <Button x:Name="RefreshButton" Content="刷新" Width="90" Height="28" Margin="0,10,0,0"
                        HorizontalAlignment="Left" Click="OnRefreshClick" />
                <Button x:Name="OpenLogsButton" Content="打开日志目录" Width="120" Height="28" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Click="OnOpenLogsClick"
                        ToolTip="注入失败或收不到消息时，先看这里日志中的 [Hook] 行" />
            </StackPanel>
        </Border>

        <!-- QQ 进程与注入 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                Background="{DynamicResource DsqqSurface}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="QQ 进程与注入状态" FontWeight="SemiBold" FontSize="14" />
                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.6" TextWrapping="Wrap"
                           Text="注入由 SnowLuma 使用原生组件完成。若此处显示未注入或收不到消息，请查看 SnowLuma 自身日志中的 [Hook] 行 —— 那属于上游问题，与本面板无关。" />
                <DataGrid x:Name="ProcessGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="140" />
                        <DataGridTextColumn Header="注入" Binding="{Binding Loaded}" Width="70" />
                        <DataGridTextColumn Header="QQ 号" Binding="{Binding Uin}" Width="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="HintText" Margin="2,10,0,0" Opacity="0.55"
                   TextTrimming="CharacterEllipsis" Text="—" />
    </Grid>
</UserControl>
