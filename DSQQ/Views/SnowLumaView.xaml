<UserControl x:Class="DSQQ.Views.SnowLumaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <!--
        SnowLuma 控制台。
        目标：日常不需要再打开 SnowLuma 的网页。

        分区：
           概览        —— 版本、账号、WebUI 登录态
           QQ 账号     —— 进程与注入状态、加载/卸载、接入点（OneBot）连接情况
           OneBot 配置 —— HTTP / WS 服务的读取与写入

        注意：协议同意与 QQ 扫码必须在 SnowLuma 自己的界面完成 ——
        那是 QQ 客户端的登录流程，本程序无法代劳，只能把你送到那里。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ WebUI 登录条（紧凑，常驻）══ -->
        <Border Grid.Row="0" Padding="12" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="WebUI 登录" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <TextBlock Text="密码" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <PasswordBox x:Name="PasswordBox" Width="180" Margin="8,0,0,0" />

                    <TextBlock Text="验证码" Margin="12,0,0,0" VerticalAlignment="Center"
                               ToolTip="仅当账号启用两步验证时填写" />
                    <TextBox x:Name="TotpBox" Width="80" Margin="8,0,0,0" />

                    <Button x:Name="LoginButton" Content="登录" Width="80" Height="28" Margin="12,0,0,0"
                            Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnLoginClick" />
                    <Button x:Name="LogoutButton" Content="退出登录" Width="90" Height="28" Margin="8,0,0,0"
                            Click="OnLogoutClick" />
                    <Button x:Name="RefreshButton" Content="全部刷新" Width="90" Height="28" Margin="8,0,0,0"
                            Click="OnRefreshClick" />
                </StackPanel>

                <TextBlock x:Name="LoginStatusText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
        </Border>

        <!-- ══ 内层分页 ══ -->
        <TabControl Grid.Row="1" x:Name="SnowLumaTabs" Margin="0,12,0,0"
                        SelectionChanged="OnInnerTabChanged">

            <!-- ── 概览 ── -->
            <TabItem Header="概览">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="OverviewText" TextWrapping="Wrap"
                               FontFamily="Consolas, Microsoft YaHei UI" LineHeight="20"
                               Text="尚未采集。" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OpenWebUiButton" Content="打开 SnowLuma 控制台" Width="170" Height="28"
                                Click="OnOpenWebUiClick"
                                ToolTip="协议同意与 QQ 扫码只能在它自己的界面完成" />
                        <Button x:Name="OpenLogsButton" Content="打开日志目录" Width="120" Height="28" Margin="8,0,0,0"
                                Click="OnOpenLogsClick"
                                ToolTip="注入失败或收不到消息时，先看这里日志中的 [Hook] 行" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurfaceAlt}">
                        <StackPanel>
                            <TextBlock Text="接入点状态（来自 /api/connections）" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="这一栏回答的是「桥接到底连上没有」：ws-default 后面显示「1 个客户端」就说明 qq-bridge 已经接上来了。" />
                            <TextBlock x:Name="ConnectionsText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19" Text="（未采集）" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── QQ 账号 ── -->
            <TabItem Header="QQ 账号">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.7" LineHeight="19"
                               Text="SnowLuma 通过把原生组件加载进 QQ 进程来工作。列表里每个进程的「已加载」表示组件已注入，「已登录」表示那个进程里的 QQ 已经登录。要让某个账号生效，选中它点「加载」。" />

                    <DataGrid Grid.Row="1" x:Name="ProcessGrid" Margin="0,10,0,0" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                            <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="已加载" Binding="{Binding InjectedText}" Width="80" />
                            <DataGridTextColumn Header="已登录" Binding="{Binding LoggedInText}" Width="80" />
                            <DataGridTextColumn Header="QQ 号" Binding="{Binding Account}" Width="130" />
                            <DataGridTextColumn Header="方式" Binding="{Binding Method}" Width="150" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="LoadProcessButton" Content="加载选中" Width="100" Height="28"
                                Click="OnLoadProcessClick"
                                ToolTip="把原生组件注入选中的 QQ 进程，让这个账号开始工作" />
                        <Button x:Name="UnloadProcessButton" Content="卸载选中" Width="100" Height="28" Margin="8,0,0,0"
                                Click="OnUnloadProcessClick" />
                        <Button x:Name="RefreshProcessButton" Content="重新探测" Width="100" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Click="OnRefreshProcessClick" />
                        <TextBlock x:Name="ProcessHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap"
                               Text="若「已加载」为假但 QQ 正在运行，说明原生组件没能挂上，属于 SnowLuma 侧的问题 —— 请查看它日志里的 [Hook] 行。" />
                </Grid>
            </TabItem>

            <!-- ── OneBot 配置 ── -->
            <TabItem Header="OneBot 配置">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="账号" VerticalAlignment="Center" />
                        <ComboBox x:Name="AccountCombo" Width="220" Margin="8,0,0,0"
                                  SelectionChanged="OnAccountChanged" />
                        <Button x:Name="ReloadConfigButton" Content="重新读取" Width="100" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Click="OnReloadConfigClick" />
                    </StackPanel>

                    <!-- HTTP 服务 -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="HTTP 服务（桥接用它发消息）" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="监听地址" VerticalAlignment="Center" Width="70" />
                                <TextBox x:Name="HttpHostBox" Width="140" />
                                <TextBlock Text="端口" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBox x:Name="HttpPortBox" Width="80" Margin="8,0,0,0" />
                                <TextBlock Text="消息格式" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="HttpFormatCombo" Width="110" Margin="8,0,0,0" />
                                <CheckBox x:Name="HttpReportSelfCheck" Content="上报自己发的消息"
                                          Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- WS 服务 -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="WebSocket 服务（桥接用它收事件）" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="监听地址" VerticalAlignment="Center" Width="70" />
                                <TextBox x:Name="WsHostBox" Width="140" />
                                <TextBlock Text="端口" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBox x:Name="WsPortBox" Width="80" Margin="8,0,0,0" />
                                <TextBlock Text="角色" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="WsRoleCombo" Width="130" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveConfigButton" Content="保存配置" Width="110" Height="30"
                                Click="OnSaveConfigClick" />
                        <Button x:Name="EnsureOneBotButton" Content="一键补全所需端口" Width="160" Height="30"
                                Margin="8,0,0,0" Click="OnEnsureOneBotClick"
                                ToolTip="确保 HTTP 3000 与 WS 3001 存在（桥接的默认指向就是这两个）" />
                        <TextBlock x:Name="ConfigHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap"
                               Text="保存是整体覆盖语义：本页读到的其它字段会原样写回，但如果你手工改过 SnowLuma 的配置文件，建议先点「重新读取」。改动通常需要重新加载账号（或重启 SnowLuma）才生效。" />
                </Grid>
            </TabItem>
            <!-- ── 日志 ── -->
            <TabItem Header="日志">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="级别" VerticalAlignment="Center" />
                        <ComboBox x:Name="LogLevelCombo" Width="140" Margin="8,0,0,0"
                                  SelectionChanged="OnLogLevelChanged"
                                  ToolTip="调低能看到更多细节，但日志量会显著增加" />
                        <Button x:Name="RefreshLogsButton" Content="刷新日志" Width="100" Height="28"
                                Margin="12,0,0,0" Click="OnRefreshLogsClick" />
                        <CheckBox x:Name="LogFollowCheck" Content="自动跟随" Margin="16,0,0,0"
                                  VerticalAlignment="Center" IsChecked="True"
                                  ToolTip="每次状态刷新时一并取回最新日志，并滚到底部" />
                        <TextBlock x:Name="LogHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.7" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" TextWrapping="NoWrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" LineHeight="17"
                                       Text="（尚未读取）" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap"
                               Text="这是 SnowLuma 自己的运行日志（含 [Hook] 注入行与消息收发）。排查完成后记得把级别调回 info —— debug/trace 会明显增加日志量。" />
                </Grid>
            </TabItem>

            <!-- ── 系统 ── -->
            <TabItem Header="系统">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="运行环境" FontWeight="SemiBold" />
                            <TextBlock x:Name="SystemInfoText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19"
                                       Text="（未采集）" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="存储占用" FontWeight="SemiBold" />
                            <TextBlock x:Name="StorageText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19"
                                       Text="（未采集）" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="日志上限(MB)" VerticalAlignment="Center" />
                                <TextBox x:Name="LogMaxMbBox" Width="80" Margin="8,0,0,0" />
                                <TextBlock Text="保留天数" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <TextBox x:Name="LogRetainDaysBox" Width="60" Margin="8,0,0,0" />
                                <CheckBox x:Name="LogPerUinCheck" Content="按账号分文件" Margin="14,0,0,0"
                                          VerticalAlignment="Center" />
                                <Button x:Name="SaveStorageButton" Content="保存设置" Width="100" Height="28"
                                        Margin="14,0,0,0" Click="OnSaveStorageClick" />
                                <Button x:Name="CleanupButton" Content="立即清理" Width="100" Height="28"
                                        Margin="8,0,0,0" Click="OnCleanupClick"
                                        ToolTip="只删过期日志与临时文件，不动账号数据" />
                            </StackPanel>

                            <TextBlock x:Name="StorageHintText" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="版本" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Text="（尚未检查）" />
                                <Button x:Name="CheckUpdateButton" Content="检查更新" Width="100" Height="28"
                                        Margin="14,0,0,0" Click="OnCheckUpdateClick" />
                                <Button x:Name="OpenReleaseButton" Content="打开发布页" Width="110" Height="28"
                                        Margin="8,0,0,0" Click="OnOpenReleaseClick" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap"
                               Text="改动日志保留设置会写入 SnowLuma 自己的配置；「立即清理」按保留策略删除过期日志与临时文件。" />
                </Grid>
            </TabItem>

            <!-- ── 安全与通知 ── -->
            <TabItem Header="安全与通知">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 改密码 -->
                    <Border Grid.Row="0" Padding="12" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="修改 WebUI 密码" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="当前密码" VerticalAlignment="Center" Width="70" />
                                <PasswordBox x:Name="OldPasswordBox" Width="180" />
                                <TextBlock Text="新密码" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <PasswordBox x:Name="NewPasswordBox" Width="180" Margin="8,0,0,0"
                                             PasswordChanged="OnNewPasswordChanged" />
                                <Button x:Name="ChangePasswordButton" Content="修改" Width="90" Height="28"
                                        Margin="14,0,0,0" Click="OnChangePasswordClick" />
                            </StackPanel>
                            <TextBlock x:Name="StrengthText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75"
                                       FontFamily="Consolas, Microsoft YaHei UI" />
                            <TextBlock x:Name="SecurityHintText" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 两步验证 -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="两步验证（TOTP）" FontWeight="SemiBold" />
                            <TextBlock x:Name="TotpStateText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="TotpBeginButton" Content="开始启用" Width="100" Height="28"
                                        Click="OnTotpBeginClick" />
                                <TextBlock Text="动态码" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <TextBox x:Name="TotpCodeBox" Width="100" Margin="8,0,0,0" />
                                <TextBlock Text="当前密码" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <PasswordBox x:Name="TotpPasswordBox" Width="160" Margin="8,0,0,0" />
                                <Button x:Name="TotpConfirmButton" Content="确认启用" Width="100" Height="28"
                                        Margin="14,0,0,0" Click="OnTotpConfirmClick" />
                                <Button x:Name="TotpDisableButton" Content="关闭两步验证" Width="120" Height="28"
                                        Margin="8,0,0,0" Click="OnTotpDisableClick" />
                            </StackPanel>

                            <TextBlock x:Name="TotpSecretText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" Opacity="0.8"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 通知 -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="通知" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="同类去抖（秒）" VerticalAlignment="Center" />
                                <TextBox x:Name="DebounceBox" Width="80" Margin="8,0,0,0" />
                                <Button x:Name="SaveNotificationsButton" Content="保存" Width="80" Height="28"
                                        Margin="12,0,0,0" Click="OnSaveNotificationsClick" />
                                <TextBlock x:Name="ChannelsText" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Opacity="0.75" />
                            </StackPanel>
                            <TextBlock x:Name="RecentNoticeText" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" Opacity="0.75" />
                            <TextBlock x:Name="NotificationHintText" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap"
                               Text="改密码与两步验证只影响 SnowLuma 的 WebUI 登录。渠道（channels）的结构随类型而变，本页不编辑它 —— 猜错字段名再回写会把配置改坏。全部改动都需要重新登录该 WebUI 才生效。" />
                </Grid>
            </TabItem>

            <!-- ── 调试面板 ── -->
            <!-- 行布局：0 工具条 / 1 主体（左列表 + 右详情）。右侧内部行：
                 0 动作抬头 / 1 参数区（可滚，限高）/ 2 调用按钮 / 3 提示 / 4 返回区（摘要 + 正文） -->
            <TabItem Header="调试面板">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <WrapPanel>
                            <TextBlock Text="分类" VerticalAlignment="Center" />
                            <ComboBox x:Name="DebugCategoryCombo" Width="150" Height="26" Margin="6,0,0,0"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="OnDebugCategoryChanged" />
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBox x:Name="DebugSearchBox" Width="200" Height="26" Margin="6,0,0,0"
                                     TextChanged="OnDebugSearchChanged" />
                            <Button x:Name="DebugReloadButton" Content="重新拉清单" Width="110" Height="26" Margin="10,0,0,0"
                                    Click="OnDebugReloadClick" />
                            <TextBlock x:Name="DebugCountText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"
                                       Text="尚未拉取。" />
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="账号" VerticalAlignment="Center" />
                            <ComboBox x:Name="DebugUinCombo" Width="170" Height="26" Margin="6,0,0,0"
                                      DisplayMemberPath="Display" />
                            <CheckBox x:Name="DebugConfirmCheck" Content="调用会改数据的动作前先确认" IsChecked="True"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="默认开着。关掉之后就点一下直接发出去，适合连着试参数的时候。" />
                        </WrapPanel>

                        <TextBlock Margin="0,8,0,0" Opacity="0.6" TextWrapping="Wrap"
                                   Text="这里直接调 SnowLuma 转发的 OneBot 动作（实测 198 个）。带 ⚠ 的会改数据 —— 踢人、退群、改名片都在里面，别在没看清参数时点「调用」。成败看返回里的 status：未知动作也是 HTTP 200，状态码说明不了任何事。" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" x:Name="DebugActionList"
                                 DisplayMemberPath="Display"
                                 SelectionChanged="OnDebugActionChanged"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <Grid Grid.Column="1" Margin="14,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="DebugDetailText" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19"
                                       Text="先在左边选一个动作。" />

                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock x:Name="DebugParamsHeader" Text="参数" FontWeight="SemiBold" />
                                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <StackPanel x:Name="DebugParamPanel" />
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="DebugInvokeButton" Content="调用" Width="130" Height="28"
                                        Click="OnDebugInvokeClick" IsEnabled="False" />
                                <Button x:Name="DebugClearParamsButton" Content="清空参数" Width="90" Height="28"
                                        Margin="8,0,0,0" Click="OnDebugClearParamsClick" />
                            </StackPanel>

                            <TextBlock Grid.Row="3" x:Name="DebugHintText" Margin="0,8,0,0" TextWrapping="Wrap" />

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" x:Name="DebugResultSummary" Text="—" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <TextBox Grid.Row="1" x:Name="DebugResultBox" Margin="0,6,0,0"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         IsReadOnlyCaretVisible="True"
                                         FontFamily="Consolas, Microsoft YaHei UI"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         ToolTip="可以直接选中复制" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock Grid.Row="2" x:Name="HintText" Margin="2,10,0,0" Opacity="0.55"
                   TextTrimming="CharacterEllipsis" Text="—" />
    </Grid>
</UserControl>
