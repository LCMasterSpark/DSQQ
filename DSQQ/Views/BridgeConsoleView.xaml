<UserControl x:Class="DSQQ.Views.BridgeConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000">
    <!--
        桥接控制台页。
        数据来自桥接自带的 HTTP API（默认 3100），因此本页不依赖任何网页。
        保存类操作会即时生效；其中改端口一类的项需要重启桥接（页面上有提示）。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部操作 -->
        <Border Grid.Row="0" Padding="12" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ReloadButton" Content="重新载入" Width="100" Height="30"
                        Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnReloadClick" />
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <!-- ══ 总览 ══ -->
            <TabItem Header="总览">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="运行模式" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox x:Name="ModeCombo" Width="200" />
                                <Button x:Name="ApplyModeButton" Content="切换模式" Width="100" Height="30"
                                        Margin="8,0,0,0" Click="OnApplyModeClick" />
                                <TextBlock Text="（切换即时生效，无需重启）" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Opacity="0.6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="模型与推理强度" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="注意：这里的设置会同时写入 DSH 的全局默认，影响 DSH 中新开的会话。" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="推理强度" VerticalAlignment="Center" />
                                <ComboBox x:Name="EffortCombo" Width="140" Margin="8,0,0,0" />
                                <Button x:Name="ApplyEffortButton" Content="保存" Width="80" Height="30"
                                        Margin="8,0,0,0" Click="OnApplyEffortClick" />
                                <TextBlock x:Name="ModelText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" />
                            <DataGrid x:Name="SessionGrid" Margin="0,8,0,0" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="会话" Binding="{Binding Key}" Width="200" />
                                    <DataGridTextColumn Header="DSH 会话 ID" Binding="{Binding SessionId}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ 白名单 ══ -->
            <TabItem Header="白名单">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="私聊" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="每行一个 QQ 号。留空表示不接受任何私聊（除非在桥接配置里打开了「空名单放行全部」）。" />
                            <TextBox x:Name="AllowPrivateBox" Margin="0,8,0,0" Height="70"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Microsoft YaHei UI" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="群聊" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="勾选表示允许该群与机器人对话。列表来自机器人当前所在的群，新入群会自动出现。" />
                            <ListBox x:Name="GroupList" Margin="0,8,0,0" DisplayMemberPath="Display"
                                     SelectionMode="Multiple" />
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveWhitelistButton" Content="保存白名单" Width="120" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Click="OnSaveWhitelistClick" />
                        <TextBlock x:Name="WhitelistHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 人设 ══ -->
            <TabItem Header="人设">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" x:Name="PersonaEnabledCheck" Content="启用人设（只影响语气与说话方式）" />

                    <TextBlock Grid.Row="1" x:Name="PersonaNoteText" Margin="0,8,0,0" Opacity="0.65"
                               TextWrapping="Wrap" />

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="它叫什么" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PersonaNameBox" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="性格基调" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PersonaToneBox" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="说话习惯" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PersonaStyleBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="绝对不做的事" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PersonaForbidBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="补充设定" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PersonaExtraBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SavePersonaButton" Content="保存人设" Width="110" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnSavePersonaClick" />
                        <TextBlock x:Name="PersonaHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 配额 ══ -->
            <TabItem Header="配额">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" x:Name="QuotaEnabledCheck" Content="启用每日配额与预警" />

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="群聊预警点 / 上限" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBox x:Name="GroupWarnBox" Width="90" />
                                <TextBlock Text="/" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="GroupLimitBox" Width="90" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="私聊预警点 / 上限" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBox x:Name="PrivateWarnBox" Width="90" />
                                <TextBlock Text="/" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="PrivateLimitBox" Width="90" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="豁免号码（每行一个）" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExemptBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Microsoft YaHei UI" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="预警文案" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="WarnTextBox" Margin="0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="今日已发" VerticalAlignment="Center" Margin="0,4,10,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TodayUsageText" Margin="0,4,0,0"
                                       VerticalAlignment="Center" Opacity="0.75" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveQuotaButton" Content="保存配额" Width="110" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnSaveQuotaClick" />
                        <TextBlock x:Name="QuotaHintText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 花费 ══ -->
            <TabItem Header="令牌与花费">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TokenSummaryText" TextWrapping="Wrap"
                               FontFamily="Consolas, Microsoft YaHei UI" LineHeight="20"
                               Text="尚未读取。" />

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="最近活动（来自桥接）" FontWeight="SemiBold" />
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ActivityText" TextWrapping="Wrap"
                                           FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19"
                                           Text="（暂无）" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="HintText" Margin="2,10,0,0" Opacity="0.55"
                   TextTrimming="CharacterEllipsis" Text="—" />
    </Grid>
</UserControl>
