<UserControl x:Class="DSQQ.Views.BridgeConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000">
    <!--
        桥接控制台页。
        数据来自桥接自带的 HTTP API（默认 3100），因此本页不依赖任何网页。
        保存类操作会即时生效；其中改端口一类的项需要重启桥接（页面上有提示）。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部操作 -->
        <Border Grid.Row="0" Padding="12" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ReloadButton" Content="重新载入" Width="100" Height="30"
                        Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnReloadClick" />
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <!-- ══ 总览 ══ -->
            <TabItem Header="总览">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="挂起审批 / 提问" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="RefreshPendingButton" Content="刷新" Width="70" Height="26"
                                        Margin="12,0,0,0" Style="{StaticResource MahApps.Styles.Button.Flat}"
                                        Click="OnRefreshPendingClick" />
                                <TextBlock x:Name="PendingCountText" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Opacity="0.75" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="应答方式：在对应会话里用管理员号回复「通过」或「拒绝」（提问则回复选项文字或自定义答案）。桌面端不做代答 —— 桥接要求审批必须来自管理员本人消息。" />
                            <DataGrid x:Name="PendingGrid" Margin="0,8,0,0" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" MaxHeight="150"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="90" />
                                    <DataGridTextColumn Header="会话" Binding="{Binding Key}" Width="180" />
                                    <DataGridTextColumn Header="内容" Binding="{Binding Detail}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="运行模式" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox x:Name="ModeCombo" Width="200" />
                                <Button x:Name="ApplyModeButton" Content="切换模式" Width="100" Height="30"
                                        Margin="8,0,0,0" Click="OnApplyModeClick" />
                                <Button x:Name="SilentToggleButton" Content="开启静默" Width="100" Height="30"
                                        Margin="16,0,0,0" Click="OnToggleSilentClick" />
                                <TextBlock x:Name="SilentStateText" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Opacity="0.6" TextWrapping="Wrap"
                                       Text="静默模式开启后不回复群友消息（仍记录），管理员私聊照常处理 —— 适合临时走开时用。" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="会话与上下文" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,10" Opacity="0.65" TextWrapping="Wrap"
                                       Text="决定她在多个群之间「记不记得住」：共享会话把所有群与私聊合并成同一段上下文，她会记得在任何群说过什么、也不容易重复发言，代价是各群记忆混在一起、同一时刻只能处理一处；按会话分开则每个群各自独立。" />

                            <RadioButton x:Name="SessionModeSharedRadio"
                                         Content="共享会话（跨群连续记忆 —— 所有群共用一段上下文）"
                                         Margin="0,2" Checked="OnSessionModeChanged" />
                            <RadioButton x:Name="SessionModePerConversationRadio"
                                         Content="按会话分开（每个群各自独立，互不干扰）"
                                         Margin="0,2" Checked="OnSessionModeChanged" />

                            <CheckBox x:Name="CrossGroupCheck" Margin="0,10,0,0"
                                      Content="允许跨群读取（她能主动查看其它群的消息，但上下文仍各自独立）" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SaveSessionButton" Content="保存" Width="80" Height="28"
                                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                                        Click="OnSaveSessionClick" />
                                <TextBlock x:Name="SessionHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="模型与推理强度" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="注意：这里的设置会同时写入 DSH 的全局默认，影响 DSH 中新开的会话。" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="模型" VerticalAlignment="Center" />
                                <ComboBox x:Name="ModelCombo" Width="240" Margin="8,0,0,0"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="OnModelChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="推理强度" VerticalAlignment="Center" />
                                <ComboBox x:Name="EffortCombo" Width="140" Margin="8,0,0,0"
                                          SelectionChanged="OnEffortChanged" />
                                <Button x:Name="ApplyModelButton" Content="保存" Width="80" Height="30"
                                        Margin="8,0,0,0" Click="OnSaveModelClick" />
                                <TextBlock x:Name="ModelText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.6" TextWrapping="Wrap"
                                       Text="「重置上下文」会清掉该会话的 DSH 映射并重建 —— 相当于让她忘掉这段对话。正在进行的回合会被中断。" />
                            <DataGrid x:Name="SessionGrid" Margin="0,8,0,0" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="会话" Binding="{Binding Key}" Width="200" />
                                    <DataGridTextColumn Header="DSH 会话 ID" Binding="{Binding SessionId}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ResetSessionButton" Content="重置选中会话的上下文"
                                        Width="180" Height="28"
                                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                                        Click="OnResetSessionClick" />
                                <Button x:Name="ResetWorkspaceButton" Content="重置全部上下文"
                                        Width="140" Height="28" Margin="8,0,0,0"
                                        Click="OnResetWorkspaceClick" />
                                <TextBlock x:Name="ResetHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ 白名单 ══ -->
            <TabItem Header="白名单">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="私聊" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="每行一个 QQ 号。留空表示不接受任何私聊（除非在桥接配置里打开了「空名单放行全部」）。" />
                            <TextBox x:Name="AllowPrivateBox" Margin="0,8,0,0" Height="70"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Microsoft YaHei UI" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="群聊" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap"
                                       Text="勾选表示允许该群与机器人对话。列表来自机器人当前所在的群，新入群会自动出现。" />
                            <ListBox x:Name="GroupList" Margin="0,8,0,0" DisplayMemberPath="Display"
                                     SelectionMode="Multiple" />
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveWhitelistButton" Content="保存白名单" Width="120" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Click="OnSaveWhitelistClick" />
                        <TextBlock x:Name="WhitelistHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 人设 ══ -->
            <TabItem Header="人设">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" x:Name="PersonaEnabledCheck" Content="启用人设（只影响语气与说话方式）" />

                    <TextBlock Grid.Row="1" x:Name="PersonaNoteText" Margin="0,8,0,0" Opacity="0.65"
                               TextWrapping="Wrap" />

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="它叫什么" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PersonaNameBox" Margin="0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="性格基调" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PersonaToneBox" Margin="0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="说话习惯" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PersonaStyleBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="绝对不做的事" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PersonaForbidBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="补充设定" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PersonaExtraBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SavePersonaButton" Content="保存人设" Width="110" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnSavePersonaClick" />
                        <TextBlock x:Name="PersonaHintText" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 配额 ══ -->
            <TabItem Header="配额">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" x:Name="QuotaEnabledCheck" Content="启用每日配额与预警" />

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="群聊预警点 / 上限" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBox x:Name="GroupWarnBox" Width="90" />
                                <TextBlock Text="/" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="GroupLimitBox" Width="90" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="私聊预警点 / 上限" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBox x:Name="PrivateWarnBox" Width="90" />
                                <TextBlock Text="/" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="PrivateLimitBox" Width="90" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="豁免号码（每行一个）" VerticalAlignment="Top" Margin="0,8,10,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExemptBox" Margin="0,4" Height="60"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Microsoft YaHei UI" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="预警文案" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="WarnTextBox" Margin="0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="上限提示语" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
                                <TextBox x:Name="WarnMessageBox" TextChanged="OnWarnMessageChanged" />
                                <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                                           Text="达到上限时自动发出的那一句。注意：本页的保存是整体提交，这个框若被清空，保存后桥接侧也就没有这句了。" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="预警配图" VerticalAlignment="Center" Margin="0,4,10,4" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                                <TextBox x:Name="QuotaImageBox" />
                                <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                                           Text="留空表示使用桥接的默认配图。当前生效：" />
                                <TextBlock x:Name="QuotaEffectiveImageText" Margin="0,2,0,0"
                                           FontFamily="Consolas, Microsoft YaHei UI" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="今日已发" VerticalAlignment="Center" Margin="0,4,10,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TodayUsageText" Margin="0,4,0,0"
                                       VerticalAlignment="Center" Opacity="0.75" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SaveQuotaButton" Content="保存配额" Width="110" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnSaveQuotaClick" />
                        <TextBlock x:Name="QuotaHintText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 活跃度（唤醒与发送频率）══ -->
            <TabItem Header="活跃度">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.75"
                               Text="时间为「秒」、频率为「次」、间隔为「毫秒」，见各行的单位标注。保存是增量提交：只写入改动过的项，未改动的保持现状；联动关系由桥接校验（例如最短潜水不能大于最长潜水）。" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="预设" VerticalAlignment="Center" Opacity="0.75" />
                        <Button x:Name="PresetHighButton" Content="高频" Width="70" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnPresetHighClick" />
                        <Button x:Name="PresetNormalButton" Content="标准" Width="70" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnPresetNormalClick" />
                        <Button x:Name="PresetLowButton" Content="低频" Width="70" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnPresetLowClick" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap"
                                   Text="点一下即把整组参数写入（会先确认，覆盖当前值）" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 分组一：唤醒频率 -->
                            <Border Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                                <StackPanel>
                                    <TextBlock Text="唤醒频率" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10" Opacity="0.6" TextWrapping="Wrap"
                                               Text="这一组决定被叫到之后多快能回话：合并窗口越小响应越碎但越快，每分钟唤醒上限越高越活跃。" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最短潜水" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SleepMinBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="秒 · 0 ~ 86400（0 = 不限制）" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最长潜水（0 = 不限制）" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SleepMaxBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="秒 · 0 ~ 86400（0 = 不限制）" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="每小时最多唤醒" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxWakeHourBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="0 ~ 1000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="每分钟最多唤醒" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxWakeMinuteBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="0 ~ 100" VerticalAlignment="Center" Margin="14,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="睡前观察窗口" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="PreSleepWaitBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="秒 · 0 ~ 3600" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="多条消息合并窗口" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="BatchWindowBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="秒 · 1 ~ 600" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />
                                    </Grid>

                                    <TextBlock x:Name="RecommendedSleepText" Margin="0,10,0,0" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 分组二：发送节奏 -->
                            <Border Margin="0,12,0,0" Padding="14" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
                                <StackPanel>
                                    <TextBlock Text="发送节奏与长度" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,10" Opacity="0.6" TextWrapping="Wrap"
                                               Text="这一组决定她发得多快、一次能发多长。单条最大字数超出会被截断。" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="单条消息最大字数" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaxMessageCharsBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="1 ~ 5000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="每小时最多发送" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxSendHourBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="0 ~ 10000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="每分钟最多发送" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxSendMinuteBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="0 ~ 1000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="连发开关" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="BurstEnabledCheck" Content="允许多条连发（勾选后她可以分多条发同一段话）"
                                      Margin="0,4" HorizontalAlignment="Left" Checked="OnActivityFieldChanged" Unchecked="OnActivityFieldChanged" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="连发间隔下限" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="BurstMinBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="毫秒 · 0 ~ 600000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="连发间隔上限" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="BurstMaxBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="毫秒 · 0 ~ 600000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="基础间隔" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="GapBaseBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="毫秒 · 0 ~ 600000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="每字追加" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="GapPerCharBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="0 ~ 1000" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="回复检查间隔" VerticalAlignment="Center" Margin="0,4,10,4" />
                                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="AutoReplyCheckBox" Width="120" HorizontalAlignment="Left" Margin="0,4" TextChanged="OnActivityFieldChanged" />
                                        <TextBlock Grid.Row="8" Grid.Column="2" Text="秒 · 1 ~ 600" VerticalAlignment="Center" Margin="12,4,0,4" Opacity="0.5" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ReloadActivityButton" Content="重新载入" Width="100" Height="30"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnReloadActivityClick" />
                        <Button x:Name="SaveActivityButton" Content="保存改动" Width="100" Height="30" Margin="8,0,0,0"
                                Click="OnSaveActivityClick" />
                        <TextBlock x:Name="ActivityHintText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 花费 ══ -->
            <TabItem Header="令牌与花费">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TokenSummaryText" TextWrapping="Wrap"
                               FontFamily="Consolas, Microsoft YaHei UI" LineHeight="20"
                               Text="尚未读取。" />

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <TextBlock Text="消耗走势（最近 24 小时，每半小时一桶）" FontWeight="SemiBold" />
                            <ScrollViewer Margin="0,8,0,0" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <DataGrid x:Name="CostTrendGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False"
                                          CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150" />
                                        <DataGridTextColumn Header="档位" Binding="{Binding TierText}" Width="80" />
                                        <DataGridTextColumn Header="tokens" Binding="{Binding TokensText}" Width="110" />
                                        <DataGridTextColumn Header="金额" Binding="{Binding CostText}" Width="100" />
                                        <DataGridTextColumn Header="轮次" Binding="{Binding TurnsText}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                            <TextBlock x:Name="CostTrendHintText" Margin="0,6,0,0" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="最近活动（来自桥接）" FontWeight="SemiBold" />
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ActivityText" TextWrapping="Wrap"
                                           FontFamily="Consolas, Microsoft YaHei UI" LineHeight="19"
                                           Text="（暂无）" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ 角色（人格）══ -->
            <TabItem Header="角色">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="RoleReloadButton" Content="刷新列表" Width="100" Height="28"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnRoleReloadClick" />
                        <Button x:Name="RoleEnableButton" Content="启用选中" Width="100" Height="28" Margin="8,0,0,0"
                                Click="OnRoleEnableClick" />
                        <Button x:Name="RoleClearButton" Content="清除角色" Width="100" Height="28" Margin="8,0,0,0"
                                Click="OnRoleClearClick" />
                        <Button x:Name="RoleNewButton" Content="新建" Width="80" Height="28" Margin="8,0,0,0"
                                Click="OnRoleNewClick" />
                        <Button x:Name="RoleDeleteButton" Content="删除" Width="80" Height="28" Margin="8,0,0,0"
                                Click="OnRoleDeleteClick" />
                        <Button x:Name="RoleRenameButton" Content="改名" Width="80" Height="28" Margin="8,0,0,0"
                                Click="OnRoleRenameClick" />
                        <TextBlock x:Name="RoleStatusText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="RoleList" Margin="0,10,0,0" DisplayMemberPath="Display"
                             SelectionChanged="OnRoleSelectionChanged" />

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="角色名" VerticalAlignment="Center" />
                                <TextBox x:Name="RoleNameBox" Width="240" Margin="8,0,0,0" />
                                <Button x:Name="RoleSaveButton" Content="保存正文" Width="100" Height="28" Margin="8,0,0,0"
                                        Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnRoleSaveClick" />
                                <TextBlock x:Name="RoleLimitText" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
                            </StackPanel>
                            <TextBox x:Name="RoleContentBox" Margin="0,10,0,0" Height="200"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Microsoft YaHei UI"
                                     TextChanged="OnRoleContentChanged" />
                            <TextBlock x:Name="RoleInjectHint" Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ 黑话词库 ══ -->
            <TabItem Header="黑话">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <ComboBox x:Name="SlangFilterCombo" Width="150" SelectionChanged="OnSlangFilterChanged" />
                        <Button x:Name="SlangReloadButton" Content="刷新" Width="80" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnSlangReloadClick" />
                        <Button x:Name="SlangExtractButton" Content="触发提取" Width="100" Height="28" Margin="8,0,0,0"
                                Click="OnSlangExtractClick" />
                        <TextBlock x:Name="SlangStatusText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="SlangDetailText" Margin="0,8,0,0" TextWrapping="Wrap"
                               Opacity="0.7" />

                    <ListBox Grid.Row="2" x:Name="SlangList" Margin="0,8,0,0" DisplayMemberPath="Display"
                             SelectionMode="Extended" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SlangConfirmButton" Content="确认选中" Width="100" Height="28"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnSlangConfirmClick" />
                        <Button x:Name="SlangRejectButton" Content="拒绝选中" Width="100" Height="28" Margin="8,0,0,0"
                                Click="OnSlangRejectClick" />
                        <Button x:Name="SlangDeleteButton" Content="删除选中" Width="100" Height="28" Margin="8,0,0,0"
                                Click="OnSlangDeleteClick" />
                        <TextBlock x:Name="SlangActionHint" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ══ 仿真提示词 ══ -->
            <TabItem Header="仿真提示词">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="预设" VerticalAlignment="Center" />
                        <ComboBox x:Name="PresetCombo" Width="180" Margin="8,0,0,0" />
                        <Button x:Name="PresetLoadButton" Content="载入" Width="80" Height="28" Margin="8,0,0,0"
                                Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnPresetLoadClick" />
                        <Button x:Name="PresetSaveButton" Content="保存" Width="80" Height="28" Margin="8,0,0,0"
                                Click="OnPresetSaveClick" />
                        <TextBlock x:Name="PresetStatusText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="PresetContentBox" Margin="0,10,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI" />

                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                               Text="这是「仿真提示词」（预设内置，管行为与协议）。保存前桥接会做安全不变量校验：缺少权限边界或正文过短会被拒绝；保存后需重启 DSH 才生效。人格与语气请在「角色」页改。" />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="HintText" Margin="2,10,0,0" Opacity="0.55"
                   TextTrimming="CharacterEllipsis" Text="—" />
    </Grid>
</UserControl>
