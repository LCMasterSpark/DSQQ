<UserControl x:Class="DSQQ.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <!--
        日志中心。
        三个来源：桥接日志、桥接活动日志、SnowLuma 日志；跟随方式是文件变化 + 增量读取。
        界面刻意做成"列表 + 过滤"而非纯文本流：日志量大时必须能按级别与关键字收敛。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Border Grid.Row="0" Padding="12" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="来源" VerticalAlignment="Center" />
                    <ComboBox x:Name="SourceCombo" Width="220" Margin="8,0,0,0"
                              SelectionChanged="OnFilterChanged" />

                    <TextBlock Text="级别" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="LevelCombo" Width="130" Margin="8,0,0,0"
                              SelectionChanged="OnFilterChanged" />

                    <TextBlock Text="关键字" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBox x:Name="FilterBox" Width="200" Margin="8,0,0,0"
                             TextChanged="OnFilterTextChanged" ToolTip="支持普通文本；以 / 开头按正则解析" />

                    <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True"
                              Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ReloadButton" Content="重新加载" Width="100" Height="28"
                            Style="{StaticResource MahApps.Styles.Button.Flat}" Click="OnReloadClick" />
                    <Button x:Name="ClearViewButton" Content="清空视图" Width="100" Height="28" Margin="8,0,0,0"
                            Click="OnClearViewClick" ToolTip="只清空界面，不修改磁盘上的日志文件" />
                    <Button x:Name="ExportButton" Content="导出诊断包" Width="120" Height="28" Margin="8,0,0,0"
                            Click="OnExportClick" ToolTip="打包最近的桥接日志、状态与端口信息，便于排查" />
                    <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="4" Background="{DynamicResource DsqqSurface}">
            <ListView x:Name="LogList" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimeText}" Width="72" Opacity="0.6"
                                       FontFamily="Consolas, Microsoft YaHei UI" />
                            <TextBlock Text="{Binding LevelText}" Width="52" Foreground="{Binding LevelBrush}"
                                       FontFamily="Consolas, Microsoft YaHei UI" />
                            <TextBlock Text="{Binding Source}" Width="110" Opacity="0.75"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas, Microsoft YaHei UI" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2" x:Name="HintText" Margin="2,10,0,0" Opacity="0.55"
                   TextTrimming="CharacterEllipsis" Text="—" />
    </Grid>
</UserControl>
