<Window x:Class="DSQQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="DSQQ —— QQ 桥接面板"
        Height="760" Width="1160"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
    <!--
        主窗口
        ─────────────────────────────────────────────────────────────
        导航结构：TabControl 承担「运行总览 / 服务管理 / 设置 / 日志」四页。
        「服务管理」与「设置」是独立 UserControl（Views/），在代码后台注入所依赖的
        AppServices —— 这样每个页面各自管理状态，主窗口不必为它们中转数据。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 顶部：标题与操作 ══ -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="QQ 桥接面板"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SubtitleText"
                           Text="正在读取状态…"
                           Margin="12,4,0,0"
                           Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton"
                        Content="刷新"
                        Width="88"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="OnRefreshClick" />
                <Button x:Name="HideToTrayButton"
                        Content="最小化到托盘"
                        Width="130"
                        Height="30"
                        Click="OnHideToTrayClick" />
            </StackPanel>
        </DockPanel>

        <!-- ══ 中部：分页 ══ -->
        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="运行总览">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 三个服务的连通性卡片 -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,16">
                        <!-- SnowLuma -->
                        <Border Margin="0,0,8,0" Padding="14" CornerRadius="4"
                                Background="{DynamicResource DsqqSurface}">
                            <StackPanel>
                                <TextBlock Text="SnowLuma" FontSize="13" Opacity="0.65" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse x:Name="SnowLumaDot" Width="11" Height="11"
                                             Fill="#B0B0B0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SnowLumaStateText" Text="未检测"
                                               Margin="8,0,0,0" FontSize="17" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="SnowLumaDetailText" Text="—"
                                           Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- qq-bridge -->
                        <Border Margin="4,0" Padding="14" CornerRadius="4"
                                Background="{DynamicResource DsqqSurface}">
                            <StackPanel>
                                <TextBlock Text="qq-bridge" FontSize="13" Opacity="0.65" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse x:Name="BridgeDot" Width="11" Height="11"
                                             Fill="#B0B0B0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BridgeStateText" Text="未检测"
                                               Margin="8,0,0,0" FontSize="17" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="BridgeDetailText" Text="—"
                                           Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- DSH -->
                        <Border Margin="8,0,0,0" Padding="14" CornerRadius="4"
                                Background="{DynamicResource DsqqSurface}">
                            <StackPanel>
                                <TextBlock Text="DSH" FontSize="13" Opacity="0.65" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse x:Name="DshDot" Width="11" Height="11"
                                             Fill="#B0B0B0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DshStateText" Text="未检测"
                                               Margin="8,0,0,0" FontSize="17" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="DshDetailText" Text="—"
                                           Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 运行细节 -->
                    <TextBlock Grid.Row="1" Text="运行细节" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <Border Grid.Row="2" Padding="14" CornerRadius="4"
                            Background="{DynamicResource DsqqSurface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailsText"
                                       Text="等待首次状态采集…"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       LineHeight="20" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 内容均由代码后台注入（都依赖 AppServices） -->
            <TabItem x:Name="ServiceTab" Header="服务管理" />
            <TabItem x:Name="BridgeConsoleTab" Header="桥接控制台" />
            <TabItem x:Name="SnowLumaTab" Header="SnowLuma" />
            <TabItem x:Name="LogsTab" Header="日志" />
            <TabItem x:Name="SettingsTab" Header="设置" />
        </TabControl>

        <!-- ══ 底部：路径提示（排障第一现场）══ -->
        <TextBlock x:Name="FooterText"
                   Grid.Row="2"
                   Margin="2,10,0,0"
                   Opacity="0.55"
                   TextTrimming="CharacterEllipsis"
                   Text="—" />
    </Grid>
</Window>
