<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DSQQ —— QQ 桥接面板（WPF / .NET 10）
    本文件只保留"项目级"设置；跨项目共享的属性（语言级别、分析器、版本号）见根目录 Directory.Build.props。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 仅用于托盘图标（System.Windows.Forms.NotifyIcon）：不引入第三方托盘库 -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DSQQ</RootNamespace>
    <AssemblyName>DSQQ</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Metro 风格 UI：MahApps.Metro 的资源字典在 App.xaml 中合并 -->
    <!--
      WFO0003：WinForms 分析器建议改用 Application.SetHighDpiMode 配置 DPI。
      本项目只在托盘用到 WinForms，界面完全由 WPF 渲染，DPI 已由 app.manifest 的
      PerMonitorV2 声明管理；改用 WinForms 的 DPI API 反而会与 WPF 的 DPI 处理冲突。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>

</Project>