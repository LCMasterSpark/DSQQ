<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props —— 解决方案级共享构建属性
  ─────────────────────────────────────────────────────────────
  放在仓库根目录，MSBuild 会自动向上查找并应用到所有项目（src 与 tests 通吃）。
  目的：把"工程规范"集中一处，避免每个 csproj 各写一份而漂移。
-->
<Project>

  <PropertyGroup>
    <!-- ── 语言与编译 ── -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- 禁止把 obj/bin 之外的中间产物散落；保留默认即可 -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!--
      不生成 XML 文档文件（注释已统一为普通 // 行注释，不参与 API 文档）。
      原文件里这个属性被设置过两次（先 true 后 false），后者生效 ——
      写两遍既有误导性也容易在下次改动时踩错，这里只保留一处。
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ── 版本与产品信息 ── -->
  <PropertyGroup>
    <!--
      只在这里定义 Version；AssemblyVersion / FileVersion 由它派生。
      原先三者都写死，导致 -p:Version=x.y.z 只能改 Version，
      文件属性里显示的仍是旧版本 —— 发布时看着像"版本号没生效"。
    -->
    <Version>0.4.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Company>DSQQ</Company>
    <Product>DSQQ —— QQ 桥接面板</Product>
    <Authors>lenovo</Authors>
    <Copyright>Copyright (c) 2026</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- 说明：本程序是使用方，不包含 SnowLuma / qq-bridge 的任何二进制 -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- ── 健壮性：把可疑代码从"警告"提升为"错误" ── -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <WarningLevel>5</WarningLevel>
  </PropertyGroup>

  <!-- ── 速度与体积：Release 打开优化，Debug 保证可调试 ── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

</Project>
